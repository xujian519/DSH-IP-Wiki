{
  "name": "dsh-ip-wiki",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness 插件：IP 知识库面板——卡片树、卡片阅读、整理报告，全部在 Harness 内完成，不再二次打开 Obsidian 或文件管理器",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^26.0.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc --noEmit -p tsconfig.json && tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint . --type-aware --deny-warnings --ignore-pattern 'tests/gates/fixtures/**'",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify:docs": "vitest run tests/gates/docs-links.spec.ts tests/gates/notes.spec.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test:coverage"
  }
}
